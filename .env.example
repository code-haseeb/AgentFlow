# ========================================================
# AgentFlow - Environment Configuration
# ========================================================

# App & Environment
NODE_ENV=development
PORT=4000
WEB_PORT=3000

# Security & JWT
JWT_SECRET=super-secret-agentflow-jwt-key-change-in-production-min-32-chars
JWT_EXPIRES_IN=1d
REFRESH_TOKEN_SECRET=super-secret-agentflow-refresh-token-key-change-min-32
REFRESH_TOKEN_EXPIRES_IN=7d
COOKIE_SECRET=agentflow-secure-cookie-secret-min-32

# Database (PostgreSQL + pgvector)
POSTGRES_USER=agentflow
POSTGRES_PASSWORD=agentflow_dev_password
POSTGRES_DB=agentflow
POSTGRES_PORT=5432
DATABASE_URL=postgresql://agentflow:agentflow_dev_password@localhost:5432/agentflow?schema=public

# Redis (Caching & Job Queue)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# CORS
CORS_ORIGIN=http://localhost:3000
